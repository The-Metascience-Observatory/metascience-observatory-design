    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0"
  }
